# This file is a template. Copy it outside the repository before editing.

[archive]
# Number of user turns accumulated before a normal Stop-triggered archive.
# PreCompact always triggers the official transcript-mine path.
interval_user_turns = 15

# Allow multiple Codex MCP processes to write concurrently only when the
# configured MemPalace backend coordinates cross-process writers (Qdrant or
# pgvector). The upstream MCP still rejects this override for local backends.
[mcp]
allow_peer_writer = false
